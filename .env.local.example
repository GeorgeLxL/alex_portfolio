# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Auth — used to sign the admin session cookie. Use any long random string.
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Resend (optional — contact form still works without it; messages are saved to Supabase)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=onboarding@resend.dev
